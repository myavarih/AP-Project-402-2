<Page x:Class="AP_Project.Front.Restaurant_Window.EditFood"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AP_Project.Front.Restaurant_Window"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="800"
      Title="EditFoodPanel">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10">
            <TextBlock Text="Edit Food" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" TextAlignment="Center"/>

            <TextBlock Text="Name:" FontSize="16" Margin="0,10,0,5"/>
            <TextBox Name="NameTextBox" Width="300" Height="30" Text="{Binding Name, Mode=TwoWay}" Margin="0,0,0,10"/>

            <TextBlock Text="Ingredients:" FontSize="16" Margin="0,10,0,5"/>
            <TextBox Name="IngredientsTextBox" Width="300" Height="30" Text="{Binding Ingredients, Mode=TwoWay}" Margin="0,0,0,10"/>

            <TextBlock Text="Image Name:" FontSize="16" Margin="0,10,0,5"/>
            <TextBox Name="ImageNameTextBox" Width="300" Height="30" Text="{Binding ImageName, Mode=TwoWay}" Margin="0,0,0,10"/>

            <TextBlock Text="Price:" FontSize="16" Margin="0,10,0,5"/>
            <TextBox Name="PriceTextBox" Width="300" Height="30" Text="{Binding Price, Mode=TwoWay}" Margin="0,0,0,10"/>

            <TextBlock Text="Category:" FontSize="16" Margin="0,10,0,5"/>
            <TextBox Name="CategoryTextBox" Width="300" Height="30" Text="{Binding Category, Mode=TwoWay}" Margin="0,0,0,10"/>
        </StackPanel>

        <!-- Back Button -->
        <Button Content="Back" Width="100" Height="30" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Click="BackButton_Click"/>
    </Grid>
</Page>
