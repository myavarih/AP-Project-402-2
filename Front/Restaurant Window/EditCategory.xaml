<Page x:Class="AP_Project.Front.Restaurant_Window.EditCategory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AP_Project.Front.Restaurant_Window"
      mc:Ignorable="d" 
      d:DesignHeight="400" d:DesignWidth="400"
      Title="FoodCategoriesPanel">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10" Grid.Row="0">
            <TextBlock Text="Food Categories" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" TextAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBox Name="NewCategoryTextBox" Width="150" Height="30" Margin="0,0,10,0"/>
                <Button Content="Add New Category" Width="150" Height="30" Click="AddCategoryButton_Click"/>
            </StackPanel>
        </StackPanel>

        <ListView Name="CategoriesListView" Width="350" Height="300" Grid.Row="1" HorizontalAlignment="Center" ItemsSource="{Binding Categories}">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="10" VerticalAlignment="Center">
                        <TextBox Text="{Binding ., Mode =TwoWay}" FontSize="18" FontWeight="Bold" Width="150" Margin="0,0,10,0"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Content="Remove" Width="75" Height="30" Margin="5" Click="RemoveCategoryButton_Click" Tag="{Binding}"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>


        <!-- Back Button -->
        <Button Content="Back" Width="100" Height="30" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Grid.Row="2" Click="BackButton_Click"/>
    </Grid>
</Page>
