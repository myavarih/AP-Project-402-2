<Page x:Class="AP_Project.Front.Restaurant_Window.OrderReserveHistory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:local="clr-namespace:AP_Project.Front.Restaurant_Window"
      mc:Ignorable="d"
      Title="Orders and Reserves" Height="600" Width="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <!-- Add this row for the buttons -->
        </Grid.RowDefinitions>

        <!-- Filters -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CCCCCC" BorderThickness="1" Margin="10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Filter by User Username -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="10">
                    <TextBlock Text="Filter by User Username:" VerticalAlignment="Center"/>
                    <TextBox Width="150" Text="{Binding UsernameFilter, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
                </StackPanel>

                <!-- Filter by User Phone Number -->
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="10">
                    <TextBlock Text="Filter by User Phone Number:" VerticalAlignment="Center"/>
                    <TextBox Width="150" Text="{Binding PhoneNumberFilter, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
                </StackPanel>

                <!-- Filter by Food -->
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="10">
                    <TextBlock Text="Filter by Food:" VerticalAlignment="Center"/>
                    <TextBox Width="150" Text="{Binding FoodFilter, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
                </StackPanel>

                <!-- Filter by Min Price -->
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="10">
                    <TextBlock Text="Filter by Min Price:" VerticalAlignment="Center"/>
                    <TextBox Width="80" Text="{Binding MinPriceFilter, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
                </StackPanel>

                <!-- Filter by Max Price -->
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="10">
                    <TextBlock Text="Filter by Max Price:" VerticalAlignment="Center"/>
                    <TextBox Width="80" Text="{Binding MaxPriceFilter, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Orders -->
        <ListView Grid.Row="1" ItemsSource="{Binding FilteredOrders}" Width="Auto" Height="Auto" HorizontalAlignment="Center">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Order Code" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Code}" FontWeight="Bold" Margin="10,0"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="User Username" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding UserUsername}" FontWeight="Bold" Margin="10,0"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="User Phone Number" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding UserPhoneNumber}" Margin="10,0"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Cart" Width="250">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <ItemsControl ItemsSource="{Binding Cart}" Margin="10,0">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Vertical"/>
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Margin="0,0,10,0"/>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Total Cost" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding TotalCost, StringFormat='Total Cost: ${0:F2}'}" Margin="10,0"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Buttons -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Stretch" VerticalAlignment="Bottom" Margin="10">
            <Button Content="Back" Width="100" HorizontalAlignment="Left" Click="BackButton_Click"/>
            <Button Content="Get Report" Width="100" HorizontalAlignment="Right" Click="GetReportButton_Click"/>
        </StackPanel>
    </Grid>
</Page>
