<Page x:Class="AP_Project.Front.Restaurant_Window.ChangeFoodInventory"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AP_Project.Front.Restaurant_Window"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="800"
      Title="FoodInventoryPanel">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10" Grid.Row="0">
            <TextBlock Text="Food Inventory" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" TextAlignment="Center"/>
        </StackPanel>

        <ListView Name="FoodInventoryListView" Width="750" Height="600" Grid.Row="1" HorizontalAlignment="Center">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal" Margin="10" VerticalAlignment="Center">
                        <Image Source="{Binding ImageName}" Width="100" Height="100" Margin="10"/>
                        <StackPanel VerticalAlignment="Center" Width="400">
                            <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
                            <TextBlock Text="Group: {Binding Category}" FontSize="14" Foreground="Gray" Margin="0,0,0,5"/>
                            <TextBlock Text="Price: {Binding Price}" FontSize="14" Foreground="Gray" Margin="0,0,0,5"/>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBox Name="InventoryTextBox" Width="100" Height="30" Margin="0,0,10,0" Text="{Binding Inventory, Mode=TwoWay}"/>
                            <Button Content="Update Inventory" Width="150" Height="30" Margin="0,0,0,0" Command="{Binding UpdateInventoryCommand}"/>
                        </StackPanel>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Back Button -->
        <Button Content="Back" Width="100" Height="30" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Grid.Row="2" Click="BackButton_Click"/>
    </Grid>
</Page>
