<Page x:Class="AP_Project.PasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      mc:Ignorable="d"
      Title="Password Choosing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Verification Code -->
        <Label Content="Verification Code:" Grid.Row="0" Grid.Column="0" VerticalAlignment="Center"/>
        <xctk:WatermarkTextBox x:Name="VerificationCodeTxtBx" Watermark="Enter Verification Code" Grid.Row="0" Grid.Column="1" Height="25" Width="159" VerticalAlignment="Center"/>

        <!-- Password -->
        <Label Content="Password:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center"/>
        <xctk:WatermarkTextBox x:Name="PasswordTxtBx" Watermark="Enter Password" Grid.Row="1" Grid.Column="1" Height="25" Width="159" VerticalAlignment="Center" />

        <!-- Confirm Password -->
        <Label Content="Confirm Password:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center"/>
        <xctk:WatermarkTextBox x:Name="ConfirmPasswordTxtBx" Watermark="Confirm Password" Grid.Row="2" Grid.Column="1" Height="25" Width="159" VerticalAlignment="Center" />

        <!-- Create Account Button -->
        <Button Content="Create Account" Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Height="31" Width="132" HorizontalAlignment="Center" VerticalAlignment="Center" Click="CreateAccount_Click" />
    </Grid>
</Page>
