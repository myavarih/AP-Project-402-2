<Page x:Class="AP_Project.RestaurantViewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AP_Project"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1100"
      Title="RestaurantViewPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Row for Filter by Section -->
            <RowDefinition Height="*"/>
            <!-- Row for ListView -->
        </Grid.RowDefinitions>

        <!-- Filter by Section -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
            <TextBlock Text="Filter by Section:" VerticalAlignment="Center" Margin="5"/>
            <ComboBox x:Name="DropdownMenu" Width="200" Margin="5" ItemsSource="{Binding Categories}">
            </ComboBox>
            <Button Content="Apply Filter" Margin="5" Click="ApplyFiltersButton_Click"/>
        </StackPanel>

        <!-- ListView for displaying foods -->
        <ListView ItemsSource="{Binding Foods}" Grid.Row="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Food Name" DisplayMemberBinding="{Binding Name}" Width="150"/>
                    <GridViewColumn Header="Ingredients" DisplayMemberBinding="{Binding Ingredients}" Width="200"/>
                    <GridViewColumn Header="Price" DisplayMemberBinding="{Binding Price}" Width="80"/>
                    <GridViewColumn Header="Rating" DisplayMemberBinding="{Binding Rating}" Width="80"/>
                    <GridViewColumn Header="Image" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding ImagePath}" Width="100" Height="100"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Actions" Width="250">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Reserve" Margin="5" Click="ReserveButton_Click" Tag="{Binding Name}"/>
                                    <Button Content="Order" Margin="5" Click="OrderButton_Click" Tag="{Binding Name}"/>
                                    <Button Content="Rate" Margin="5" Click="RateButton_Click" Tag="{Binding Name}"/>
                                    <Button Content="Comment" Margin="5" Click="CommentButton_Click" Tag="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>
    </Grid>
</Page>
