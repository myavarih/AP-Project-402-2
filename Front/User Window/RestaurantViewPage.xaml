<Page x:Class="AP_Project.RestaurantViewPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AP_Project"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1100"
      Title="RestaurantViewPage">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Filter by Section and Title -->
        <StackPanel Orientation="Vertical" HorizontalAlignment="Center" Margin="5" Grid.Row="0">
            <TextBlock Text="{Binding RestaurantName}" FontSize="24" FontWeight="Bold" Margin="5" HorizontalAlignment="Center"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                <TextBlock Text="Filter by Section:" VerticalAlignment="Center" Margin="5"/>
                <ComboBox x:Name="DropdownMenu" Width="200" Margin="5" ItemsSource="{Binding Categories}" SelectionChanged="ApplyFilters" SelectedIndex="0"/>
                <Button Content="Reserve" Margin="5" Click="ReserveButton_Click"/>
            </StackPanel>
        </StackPanel>

        <!-- ListView for displaying foods -->
        <ListView ItemsSource="{Binding Foods}" Grid.Row="1">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Food Name" DisplayMemberBinding="{Binding Name}" Width="150"/>
                    <GridViewColumn Header="Ingredients" DisplayMemberBinding="{Binding Ingredients}" Width="200"/>
                    <GridViewColumn Header="Price" DisplayMemberBinding="{Binding Price}" Width="80"/>
                    <GridViewColumn Header="Rating" DisplayMemberBinding="{Binding Rating}" Width="80"/>
                    <GridViewColumn Header="Image" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <Image Source="{Binding ImageName}" Width="100" Height="100"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Actions" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Button Content="Comment/Rate" Margin="5" Click="CommentRateButton_Click" Tag="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Count" Width="100">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Count}" Width="50"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                    <GridViewColumn Header="Order" Width="150">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Tag="{Binding Name}">
                                    <TextBox Text="0" Width="20" Tag="{Binding Name}"/>
                                    <Button Content="Order" Margin="5" Click="AddOrderButton_Click" Tag="{Binding Name}"/>
                                </StackPanel>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Bottom Buttons Row -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Back Button at Bottom Left -->
            <Button Content="Back" Width="100" Height="50" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Click="BackButton_Click" Grid.Column="0"/>

            <!-- Order Button at Bottom Right -->
            <Button Content="Finalize Order" Width="100" Height="50" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10" Click="OrderButton_Click" Grid.Column="1"/>
        </Grid>
    </Grid>
</Page>
