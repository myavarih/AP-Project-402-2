<Page x:Class="AP_Project.Front.User_Window.UserComplaints"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AP_Project.Front.User_Window"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="1050"
      Title="UserComplaints">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Page Title -->
        <TextBlock Text="User Complaints" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="10"/>

        <!-- Complaints List -->
        <ListView Grid.Row="1" x:Name="ComplaintsListView" Margin="10">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Title" DisplayMemberBinding="{Binding Title}" Width="150"/>
                    <GridViewColumn Header="Body" DisplayMemberBinding="{Binding Body}" Width="250"/>
                    <GridViewColumn Header="Restaurant Username" DisplayMemberBinding="{Binding RestaurantUsername}" Width="150"/>
                    <GridViewColumn Header="Is Solved" DisplayMemberBinding="{Binding IsSolved}" Width="100"/>
                    <GridViewColumn Header="Created Time" DisplayMemberBinding="{Binding CreatedTime}" Width="150"/>
                    <GridViewColumn Header="Response" DisplayMemberBinding="{Binding Response}" Width="250"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Add Complaint Form -->
        <StackPanel Grid.Row="2" Orientation="Vertical" Margin="10">
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Title:" VerticalAlignment="Center" Width="100"/>
                <TextBox x:Name="TitleTextBox" Width="700"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Body:" VerticalAlignment="Center" Width="100"/>
                <TextBox x:Name="BodyTextBox" Width="700"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" Margin="5">
                <TextBlock Text="Restaurant Name:" VerticalAlignment="Center" Width="100"/>
                <TextBox x:Name="RestaurantNameTextBox" Width="700"/>
            </StackPanel>
            <Button Content="Add Complaint" Click="AddComplaintButton_Click" Margin="5"/>
        </StackPanel>

        <!-- Back Button -->
        <Button Grid.Row="3" Content="Back" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Click="BackButton_Click"/>
    </Grid>
</Page>
