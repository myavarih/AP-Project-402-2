<Page x:Class="AP_Project.Front.Admin_Window.RestaurantsView"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AP_Project"
      mc:Ignorable="d" 
      d:DesignHeight="800" d:DesignWidth="1100"
      Title="SearchRestaurants">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="50"/>
            <RowDefinition Height="50"/>
            <RowDefinition/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Filter by Name Section -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,9" Width="666" Grid.Row="0">
            <TextBlock Text="Filter by Name:" Margin="5" Height="23"/>
            <TextBox x:Name="NameFilterTextBox" Width="563" Margin="5" Height="23"/>
        </StackPanel>

        <!-- Filter by City Section -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,7,0,10" Width="852" Grid.Row="1">
            <TextBlock Text="Filter by City:" Margin="5"/>
            <TextBox x:Name="CityFilterTextBox" Width="150" Margin="5"/>

            <TextBlock Text="Filter by Complaints:" Margin="5"/>
            <!-- The index is important -->
            <ComboBox x:Name="HasComplaintFilterComboBox" Width="200" Margin="5">
                <ComboBoxItem Content="No Filter"/>
                <ComboBoxItem Content="Has Unsolved Complaints"/>
                <ComboBoxItem Content="Has Only Solved Complaints"/>
                <ComboBoxItem Content="Has No Complaints"/>
            </ComboBox>

            <TextBlock Text="Min Rating:" Margin="5"/>
            <TextBox x:Name="MinRateTextBox" Width="150" Margin="5"/>

            <Button Content="Apply Filters" Margin="5" Click="ApplyFiltersButton_Click"/>
        </StackPanel>

        <!-- ListView for displaying restaurants -->
        <ListView x:Name="RestaurantsListView" Grid.Row="2">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Restaurant Name" DisplayMemberBinding="{Binding Name}" Width="200"/>
                    <GridViewColumn Header="Rating" DisplayMemberBinding="{Binding TotalRate}" Width="100"/>
                    <GridViewColumn Header="City" DisplayMemberBinding="{Binding City}" Width="200"/>
                    <GridViewColumn Header="Address" DisplayMemberBinding="{Binding Address}" Width="300"/>
                    <GridViewColumn Header="Serving Mode" DisplayMemberBinding="{Binding ServingMode}" Width="200"/>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Back Button at Bottom Left -->
        <Button Content="Back" Width="100" Height="50" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Click="BackButton_Click" Grid.Row="3"/>
    </Grid>
</Page>
