<Page x:Class="AP_Project.Front.Admin_Window.AdminComplaints"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AP_Project.Front.Admin_Window"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="1200"
      Title="AdminComplaints">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Page Title -->
        <TextBlock Text="Admin Complaints" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="10"/>

        <!-- Complaints List -->
        <ListView Grid.Row="1" x:Name="ComplaintsListView" Margin="10" IsSynchronizedWithCurrentItem="True">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Title" DisplayMemberBinding="{Binding Title}" Width="150"/>
                    <GridViewColumn Header="Body" DisplayMemberBinding="{Binding Body}" Width="250"/>
                    <GridViewColumn Header="User Username" DisplayMemberBinding="{Binding UserUsername}" Width="150"/>
                    <GridViewColumn Header="Restaurant Username" DisplayMemberBinding="{Binding RestaurantUsername}" Width="150"/>
                    <GridViewColumn Header="Is Solved" DisplayMemberBinding="{Binding IsSolved}" Width="100"/>
                    <GridViewColumn Header="Created Time" DisplayMemberBinding="{Binding CreatedTime}" Width="150"/>
                    <GridViewColumn Header="Response" Width="250">
                        <GridViewColumn.CellTemplate>
                            <DataTemplate>
                                <TextBox Text="{Binding Response, UpdateSourceTrigger=PropertyChanged}" Width="230"/>
                            </DataTemplate>
                        </GridViewColumn.CellTemplate>
                    </GridViewColumn>
                </GridView>
            </ListView.View>
        </ListView>

        <!-- Back Button -->
        <Button Grid.Row="2" Content="Back" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Click="BackButton_Click"/>
    </Grid>
</Page>
