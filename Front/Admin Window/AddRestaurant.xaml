<Page x:Class="AP_Project.Front.Admin_Window.AddRestaurant"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AP_Project.Front.Admin_Window"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AddRestaurant">

    <Grid Margin="10">
        <StackPanel>
            <TextBlock Text="Username" Margin="5"/>
            <TextBox Text="{Binding Username, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

            <TextBlock Text="Name" Margin="5"/>
            <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

            <TextBlock Text="City" Margin="5"/>
            <TextBox Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

            <TextBlock Text="Address" Margin="5"/>
            <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

            <CheckBox Content="Dine In" IsChecked="{Binding DineIn, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>
            <CheckBox Content="Delivery" IsChecked="{Binding Delivery, UpdateSourceTrigger=PropertyChanged}" Margin="5"/>

            <Button Content="Submit" Click="SubmitButton_Click" Margin="10" Width="100" HorizontalAlignment="Center"/>
        </StackPanel>
        <!-- Back Button -->
        <Button Grid.Row="3" Content="Back" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Click="BackButton_Click"/>
    </Grid>
</Page>
