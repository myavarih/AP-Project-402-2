<Page x:Class="AP_Project.PasswordPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
      mc:Ignorable="d"
      Title="Password Choosing">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <!-- Added row for back button -->
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Page Title -->
        <TextBlock Text="Choose Your Password" FontSize="28" FontWeight="Bold" Grid.Row="0" Grid.ColumnSpan="2" HorizontalAlignment="Center" Margin="0,0,0,20"/>

        <!-- Verification Code -->
        <Label Content="Verification Code:" Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
        <xctk:WatermarkTextBox x:Name="VerificationCodeTxtBx" Watermark="Enter Verification Code" Grid.Row="1" Grid.Column="1" Height="25" Width="200" VerticalAlignment="Center" Margin="0,5"/>

        <!-- Password -->
        <Label Content="Password:" Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
        <xctk:WatermarkTextBox x:Name="PasswordTxtBx" Watermark="Enter Password" Grid.Row="2" Grid.Column="1" Height="25" Width="200" VerticalAlignment="Center" Margin="0,5"/>

        <!-- Confirm Password -->
        <Label Content="Confirm Password:" Grid.Row="3" Grid.Column="0" VerticalAlignment="Center" Margin="0,5"/>
        <xctk:WatermarkTextBox x:Name="ConfirmPasswordTxtBx" Watermark="Confirm Password" Grid.Row="3" Grid.Column="1" Height="25" Width="200" VerticalAlignment="Center" Margin="0,5"/>

        <!-- Create Account Button -->
        <Button Content="Create Account" Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2" Height="35" Width="150" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,20" Click="CreateAccount_Click"/>

        <!-- Back Button -->
        <Button Content="Back" Grid.Row="5" Grid.Column="0" Height="30" Width="100" HorizontalAlignment="Left" VerticalAlignment="Center" Click="BackButton_Click" Margin="0,10"/>
    </Grid>
</Page>
