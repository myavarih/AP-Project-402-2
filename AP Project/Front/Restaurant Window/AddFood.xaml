<Page x:Class="AP_Project.Front.Restaurant_Window.AddFood"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AP_Project.Front.Restaurant_Window"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="800"
      Title="AddFoodPanel">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10" Grid.Row="0">
            <TextBlock Text="Add New Food" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" TextAlignment="Center"/>
        </StackPanel>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10" Grid.Row="1">
            <TextBlock Text="Name:" FontSize="16" Margin="0,10,0,5"/>
            <TextBox Name="NameTextBox" Width="300" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Ingredients:" FontSize="16" Margin="0,10,0,5"/>
            <TextBox Name="IngredientsTextBox" Width="300" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Image Name:" FontSize="16" Margin="0,10,0,5"/>
            <TextBox Name="ImageNameTextBox" Width="300" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Price:" FontSize="16" Margin="0,10,0,5"/>
            <TextBox Name="PriceTextBox" Width="300" Height="30" Margin="0,0,0,10"/>

            <TextBlock Text="Category:" FontSize="16" Margin="0,10,0,5"/>
            <TextBox Name="CategoryTextBox" Width="300" Height="30" Margin="0,0,0,10"/>

            <Button Content="Add Food" Width="100" Height="30" Margin="0,20,0,0" Click="AddFoodButton_Click"/>
        </StackPanel>

        <!-- Back Button -->
        <Button Content="Back" Width="100" Height="30" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Grid.Row="2" Click="BackButton_Click"/>
    </Grid>
</Page>
