<Page x:Class="AP_Project.Front.Restaurant_Window.EditMenu"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AP_Project.Front.Restaurant_Window"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="800"
      Title="FoodListPanel">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Top" Margin="10">
            <TextBlock Text="Food List" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" TextAlignment="Center"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,20">
                <Button Content="Add New Food" Width="150" Height="40" Margin="10" Click="AddFood_Click"/>
                <Button Content="Edit Food Categories" Width="150" Height="40" Margin="10" Click="EditCategories_Click"/>
            </StackPanel>

            <ListView Name="FoodListView" Width="700" Height="500">
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="10" VerticalAlignment="Center">
                            <Image Source="{Binding ImagePath}" Width="100" Height="100" Margin="10"/>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="Bold" Margin="0,0,0,5"/>
                                <TextBlock Text="{Binding Category}" FontSize="14" Foreground="Gray"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10">
                                <Button Content="Edit" Width="75" Height="30" Margin="5" Click="EditFood_Click"/>
                                <Button Content="Remove" Width="75" Height="30" Margin="5"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </StackPanel>

        <!-- Back Button -->
        <Button Content="Back" Width="100" Height="30" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="10" Click="BackButton_Click"/>
    </Grid>
</Page>
