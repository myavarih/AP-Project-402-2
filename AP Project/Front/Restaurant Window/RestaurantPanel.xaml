<Page x:Class="AP_Project.Front.Restaurant_Window.RestaurantPanel"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:AP_Project.Front.Restaurant_Window"
      mc:Ignorable="d" 
      d:DesignHeight="700" d:DesignWidth="800"
      Title="RestaurantPanel">

    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="Welcome &lt;Restaurant Name&gt;" FontSize="24" FontWeight="Bold" Margin="0,0,0,20" TextAlignment="Center"/>

            <Button Content="Change Menu" Width="200" Height="50" Margin="0,10" Click="ChangeMenu_Click"/>
            <Button Content="Change Food Inventory" Width="200" Height="50" Margin="0,10" Click="ChangeFoodInventory_Click"/>
            <Button Content="Activate/Deactivate Reserve Service" Width="200" Height="50" Margin="0,10" Click="ReserveService_Click"/>
            <Button Content="Order and Reserve History" Width="200" Height="50" Margin="0,10" Click="OrderReserveHIstory_Click"/>
        </StackPanel>
    </Grid>
</Page>
